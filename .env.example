# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Database connection URL.
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./bulk_cert.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://your_user:your_password@localhost:5432/bulk_cert_db

# Directory where generated PDF certificates are saved.
CERTIFICATES_DIR=generated_certificates

# Port the server listens on (Render sets this automatically).
PORT=8000

# ─── Render Free Tier Deployment Note ────────────────────────────────────────
# Render's free web service uses an ephemeral filesystem.
# SQLite (.db file) and generated_certificates/ are LOST on every redeploy
# or restart. This is fine for demos and assignments.
# For production, use a managed DB (e.g. Render PostgreSQL) and object storage.
